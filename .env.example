# Simple mode (default) — no env needed, site works with built-in content.
# Contact form logs to console and returns ok:true.

# Full mode (optional Postgres — enables /admin editing + message storage):
# Get a free DB from Neon (https://neon.tech) or Supabase, then set:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Admin login (full mode only):
# ADMIN_EMAIL=admin@galaxy.dev
# ADMIN_USERNAME=galaxy
# ADMIN_PASSWORD=change-me-to-something-strong
